# International digits only, no +, spaces or punctuation.
# LLinen Earth India WhatsApp business number.
NEXT_PUBLIC_WHATSAPP_NUMBER=919226338282

# Server-only key used by FASHN visualization and homepage model rendering.
FASHN_API_KEY=

# Cloud memory database. Server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Private bearer token used only by LLinen Earth OS to pull cloud events.
# Use a long random secret and never expose it through NEXT_PUBLIC_*.
LLINEN_OPERATOR_SYNC_TOKEN=

# Web Operator Desk authentication. Server-only.
# Generate the password hash with: npm run operator-password
LLINEN_OPERATOR_PASSWORD_HASH=

# Separate random session-signing secret, minimum 32 characters.
LLINEN_OPERATOR_SESSION_SECRET=
