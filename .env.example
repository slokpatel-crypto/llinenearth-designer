# International digits only, no +, spaces or punctuation.
# Linen Earth India WhatsApp business number.
NEXT_PUBLIC_WHATSAPP_NUMBER=919226338282

# Server-only key used by FASHN visualization and homepage model rendering.
FASHN_API_KEY=

# Cloud memory database. Server-only.
SUPABASE_URL=
# Preferred on newer Supabase projects. Server-only; never expose through NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Supabase public key used by the server-side email OTP flow.
# It is a publishable Supabase credential, but Linen Earth does not need to expose it to browser code.
SUPABASE_ANON_KEY=

# Legacy fallback while migrating older projects. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Private bearer token used only by Linen Earth OS to pull cloud events.
# Use a long random secret and never expose it through NEXT_PUBLIC_*.
LINEN_OPERATOR_SYNC_TOKEN=

# Web Operator Desk authentication. Server-only.
# Generate the password hash with: npm run operator-password
LINEN_OPERATOR_PASSWORD_HASH=

# Separate random session-signing secret, minimum 32 characters.
LINEN_OPERATOR_SESSION_SECRET=

# Signs anonymous public Style Director journey tokens. Server-only, minimum 32 characters.
LINEN_MEMORY_SESSION_SECRET=

# Signs authenticated Linen Earth customer-account sessions after Supabase OTP verification.
# Use a dedicated random secret, minimum 32 characters.
LINEN_CUSTOMER_SESSION_SECRET=

# Optional dedicated signer for 30-day locked-design share links. Server-only, minimum 32 characters.
# If omitted, the share system falls back to LINEN_MEMORY_SESSION_SECRET.
LINEN_DESIGN_SHARE_SECRET=

# Optional semantic critic for selected photoreal Designer renders.
# On Vercel, OIDC can provide auth automatically; this key is an optional fallback.
AI_GATEWAY_API_KEY=
# Current multimodal critic model; override only after verifying Gateway availability.
LINEN_VISUAL_CRITIC_MODEL=openai/gpt-5.4

# Private backend Fabric Analyzer model. No customer-facing UI uses this directly.
LINEN_FABRIC_ANALYZER_MODEL=openai/gpt-5.4

# Model used to turn reviewed public research pages into abstract design principles.
LINEN_RESEARCH_MODEL=openai/gpt-5.4

# Optional daily collection of two research sources; paused until an operator enables it.
# A server-only random secret authorizes Vercel's cron request. Never expose in NEXT_PUBLIC_*.
CRON_SECRET=
