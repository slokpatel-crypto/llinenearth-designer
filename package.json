{
  "name": "linen-earth-designer",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run fabric:tiles && npm run garment:model:build && next dev",
    "quality": "node scripts/quality-check.mjs",
    "build": "npm run fabric:tiles && npm run garment:model:build && npm run garment:model-check -- public/models/linen-earth-officewear-v1.glb && next build",
    "start": "next start",
    "local-memory": "node scripts/linen-local-bridge.mjs",
    "operator-password": "node scripts/hash-operator-password.mjs",
    "production-secrets": "node scripts/generate-production-secrets.mjs",
    "cloud:check": "node scripts/check-cloud-readiness.mjs",
    "release:check": "node scripts/release-readiness.mjs",
    "release:check:live": "node scripts/release-readiness.mjs --live",
    "fabric:sync-references": "node scripts/sync-fabric-reference-index.mjs",
    "fabric:quality": "npm run quality && npm run release:check",
    "fabric:tiles": "node --experimental-strip-types scripts/build-fabric-render-assets.mjs",
    "eval:analyzer": "node --experimental-strip-types scripts/eval-phase10.mjs analyzer",
    "eval:designer": "node --experimental-strip-types scripts/eval-phase10.mjs designer",
    "test": "npm run fabric:tiles && node --experimental-strip-types --test tests/*.test.ts",
    "eval:engine": "node --experimental-strip-types scripts/eval-phase10-engine.mjs && npm run eval:designer-snapshots && node scripts/eval-designer-advisor.cjs",
    "eval:designer-snapshots": "node --experimental-strip-types scripts/eval-phase10-designer-snapshots.mjs",
    "eval:preview-performance": "node --experimental-strip-types scripts/eval-preview-performance.mjs",
    "garment:model-check": "node --experimental-strip-types scripts/check-garment-viewer-model.mjs",
    "garment:model:build": "node scripts/build-garment-viewer-model.mjs",
    "garment:model-base:fetch": "python3 scripts/blender/bootstrap-human-base-meshes.py",
    "garment:model-body:prepare": "blender --background --factory-startup --python scripts/blender/prepare-linen-earth-body.py -- --asset-root .cache/linen-earth/blender-human-base-meshes-v1.4.1 --output .cache/linen-earth/linen-earth-officewear-body-base.blend",
    "garment:model-scene:check": "blender --background .cache/linen-earth/linen-earth-officewear-body-base.blend --python scripts/blender/preflight-linen-earth-officewear.py"
  },
  "dependencies": {
    "fashn": "^0.15.0",
    "next": "15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "motion": "^12.23.12",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "typescript": "5.9.2"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "0.35.5",
    "@img/sharp-libvips-linux-x64": "1.3.4"
  }
}
